<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="FileLogger_Json_SwapToRuntimeAsync"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(FileLogger_UseRuntimeAsync)' == 'true'">
    <ItemGroup>
      <Reference Remove="Karambolo.Extensions.Logging.File.Json" />
      <Reference Include="Karambolo.Extensions.Logging.File.Json">
        <HintPath>$(MSBuildThisFileDirectory)../../lib-runtime-async/net11.0/Karambolo.Extensions.Logging.File.Json.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
